base
base-devel
linux
linux-firmware
amd-ucode
intel-ucode
grub
efibootmgr
syslinux
memtest86+
mtools
os-prober
parted
gptfdisk
dosfstools
e2fsprogs
exfatprogs
btrfs-progs
xfsprogs
f2fs-tools
ntfs-3g
arch-install-scripts
reflector

# network
networkmanager
network-manager-applet
wpa_supplicant
iw
openssh
curl
wget
git

# graphics + desktop (XFCE + LightDM)
xorg-server
mesa
libva-mesa-driver
vulkan-intel
vulkan-radeon
xfce4
xfce4-goodies
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings
gvfs
gvfs-mtp
thunar-volman
tumbler
noto-fonts
noto-fonts-emoji

