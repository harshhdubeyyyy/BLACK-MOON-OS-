# VM guest tools (for testing the ISO in a VM)
open-vm-tools
qemu-guest-agent
virtualbox-guest-utils
spice-vdagent

# Retro pixel + macOS glass desktop (picom = blur/translucency/rounded
# corners, plank = macOS-style dock, terminus-font = pixel bitmap font)
picom
plank
terminus-font

# Local AI (no cloud account needed; models download on first use)
ollama
whisper-cpp
jupyter-notebook

# Cybersecurity toolkit (official Arch repos only, grouped by the
# BlackArch category each tool belongs to; see distro README for the
# staged BlackArch roadmap and the extras still NOT in official repos,
# e.g. metasploit, burpsuite, ffuf, bettercap, whatweb, subfinder)
# recon + scanner (blackarch-scanner, blackarch-recon)
nmap
hping
# webapp + proxy (blackarch-webapp, blackarch-proxy)
mitmproxy
sqlmap
gobuster
# forensic (blackarch-forensic)
sleuthkit
binwalk
# reversing + disassembler (blackarch-reversing, blackarch-disassembler)
radare2
# cracker (blackarch-cracker)
hashcat
john
hydra
ncrack
# wireless (blackarch-wireless)
aircrack-ng
# sniffer (blackarch-sniffer)
wireshark-qt
wireshark-cli
tcpdump
# networking (blackarch-networking)
openbsd-netcat
